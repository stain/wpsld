# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build
/.project
# Usual Eclipse suspects
.settings
.classpath
.project
.vscode
# IDEs' build output in each module (e.g. ui/bin/, VS Code's Java); not
# /bin/, which is to be the command-line tools' module (see PLAN.md)
/*/bin/

# Runtime image exported by podman build --output
/dist
