{
  "@context": {
    "geosparql": "http://www.opengis.net/ont/geosparql#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "http://schema.org/"
  },
  "@graph": [
    {
      "@id": "geosparql:Geometry",
      "@type": "rdfs:Class",
      "rdfs:comment": "A point, line or shape on the Earth, given as Well-Known Text (WKT) in [[asWKT]]. RO-Crate recommends it as the [[geo]] of a [[Place]] (see https://w3id.org/ro/crate/1.3/contextual-entities#places).",
      "rdfs:label": "Geometry",
      "rdfs:subClassOf": {
        "@id": "schema:Thing"
      }
    },
    {
      "@id": "geosparql:asWKT",
      "@type": "rdf:Property",
      "rdfs:comment": "The geometry as Well-Known Text (WKT), longitude before latitude, e.g. ```POINT (150.301195 -33.7152)```, ```LINESTRING (...)``` or ```POLYGON ((...))```. Best started with the coordinate reference system, e.g. ```<http://www.opengis.net/def/crs/OGC/1.3/CRS84> POINT (150.301195 -33.7152)```.",
      "rdfs:label": "asWKT",
      "schema:domainIncludes": {
        "@id": "geosparql:Geometry"
      },
      "schema:rangeIncludes": {
        "@id": "schema:Text"
      }
    },
    {
      "@id": "schema:geo",
      "@type": "rdf:Property",
      "schema:rangeIncludes": {
        "@id": "geosparql:Geometry"
      }
    }
  ]
}
